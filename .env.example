# --- Proveedor LLM ---
# Opciones: sambanova, cerebras, nous, freellmapi, ollama, openai
LLM_PROVIDER=sambanova

# API Key genérica (alternativa a las específicas)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Claves por proveedor
# SAMBANOVA_API_KEY=
# CEREBRAS_API_KEY=
# NOUS_API_KEY=
# OPENAI_API_KEY=

# --- Transcripción local (faster-whisper) ---
# Modelos: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# --- Persistencia ---
DATA_DIR=./data
